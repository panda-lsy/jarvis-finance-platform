[Unit]
Description=JARVIS Python AI Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/current/backend
EnvironmentFile=/etc/jarvis/python.env
ExecStart=/opt/jarvis/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
