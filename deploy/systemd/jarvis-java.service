[Unit]
Description=JARVIS Java Main Backend
After=network-online.target jarvis-ai.service
Wants=network-online.target
Requires=jarvis-ai.service

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/current/java-backend
EnvironmentFile=/etc/jarvis/java.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/jarvis/current/java-backend/app.jar
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
SuccessExitStatus=143

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
