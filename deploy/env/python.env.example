# Python AI 服务生产环境变量模板
# 复制到 /etc/jarvis/python.env，并 chmod 600。

# 必须与 java.env 中一致。
PYTHON_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN

# AI Provider 通用配置。生产环境通过 /etc/jarvis/python.env 注入真实地址与密钥。
AI_PROVIDER=cloudbase
AI_BASE_URL=CHANGE_ME_AI_BASE_URL
AI_MODEL=hy3
AI_MODEL_DISPLAY_NAME=DeepSeek V4 Flash-0731
AI_API_KEY=CHANGE_ME_AI_API_KEY
AI_TIMEOUT=60

# 可选：启用 Agent 个股实时新闻搜索；未配置或上游不可用时自动回退到国内 RSS。
TAVILY_API_KEY=

# 兼容旧环境变量，但生产建议只使用上面的 AI_*。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
